# Temporary Phase 01 prototype shape. Fill with the enrollment response.
# Install outside the release tree as /etc/flexmix/fleet.env with mode 0600.
FLEXMIX_MID=
FLEXMIX_DEVICE_UUID=
FLEXMIX_HUB_URL=
FLEXMIX_TAILNET_TAG=tag:flexmix-machine
# The private key is created and kept on the machine; never send it to Hub.
FLEXMIX_DEVICE_PRIVATE_KEY_FILE=/etc/flexmix/device-ed25519.key
# Hub never has the release private signing key.
FLEXMIX_RELEASE_PUBLIC_KEY_FILE=/etc/flexmix/release-signing-public-key.pem
