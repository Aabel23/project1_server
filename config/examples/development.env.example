# Copy to .env at repository root; fill all blank values. Never commit .env.
# Absolute paths to separate password files OUTSIDE the source tree.
FLEXMIX_DB_PASSWORD_FILE=
MYSQL_ROOT_PASSWORD_FILE=
FLEXMIX_DB_NAME=
FLEXMIX_DB_USER=
FLEXMIX_DB_HOST=127.0.0.1
FLEXMIX_DB_PORT=13306
# Prototype Phase 01 bootstrap only. The token is a local secret file (mode 0600).
FLEXMIX_PROTOTYPE_ENROLLMENT_TOKEN_FILE=
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
FLEXMIX_PROTOTYPE_HUB_URL=http://127.0.0.1:8001
FLEXMIX_PROTOTYPE_MACHINE_TAILNET_TAG=tag:flexmix-machine
