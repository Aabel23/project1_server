# Copy to /etc/nginx/sites-available/flexmix-hub and replace the placeholders.
# Obtain the certificate before enabling the HTTPS server block.

upstream flexmix_hub {
    server 127.0.0.1:8010;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name flexmix.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name flexmix.example.com;

    ssl_certificate /etc/letsencrypt/live/flexmix.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/flexmix.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 10m;
    access_log /var/log/nginx/flexmix-hub.access.log;
    error_log /var/log/nginx/flexmix-hub.error.log warn;

    location = /health {
        proxy_pass http://flexmix_hub;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 10s;
    }

    location / {
        proxy_pass http://flexmix_hub;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 60s;
    }
}
